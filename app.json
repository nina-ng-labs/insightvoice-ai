{
  "expo": {
    "name": "InsightVoice",
    "slug": "expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "expense-tracker",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ninanguyen.expensetracker",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow InsightVoice to record audio for voice transactions."
      }
    },
    "android": {
      "package": "com.ninanguyen.expensetracker",
      "permissions": ["CAMERA", "RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow InsightVoice to record audio for voice transactions."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow InsightVoice to record audio for voice transactions."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8900595042617357~5637854884"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "33a03531-d5e4-4625-bf3e-1884f1564316"
      }
    }
  }
}